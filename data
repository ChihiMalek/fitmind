# 1. Placez-vous à la racine de votre projet FitMind
cd chemin/vers/fitmind

# 2. Créez le dossier data
mkdir data

# 3. Copiez votre fichier gym.csv dans ce dossier
cp /chemin/vers/gym.csv data/

# 4. Ajoutez le fichier au suivi Git
git add data/gym.csv

# 5. Committez avec un message clair
git commit -m "Ajout du dataset Gym pour l'entraînement des modèles"

# 6. Poussez vers GitHub
git push origin main
